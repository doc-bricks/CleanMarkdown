<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">

  <Identity Name="Geiger.CleanMarkdown"
            Publisher="CN=52596601-BAB4-4F3F-B182-E8F3F273B202"
            Version="1.0.2.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>CleanMarkdown - Local Markdown Viewer &amp; Editor</DisplayName>
    <PublisherDisplayName>Geiger</PublisherDisplayName>
    <Logo>icons\icon_150x150.png</Logo>
    <Description>Lokaler Markdown-Viewer und -Editor mit Lesemodus, Raw-Editor, PDF-Export, Mathe-Vorschau und DE/EN-Oberfläche.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="de-de" />
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="CleanMarkdownApp"
                 Executable="CleanMarkdown.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="CleanMarkdown"
                          Description="Lokaler Markdown-Viewer und -Editor mit Lesemodus, Raw-Editor, PDF-Export, Mathe-Vorschau und DE/EN-Oberfläche."
                          Square150x150Logo="icons\icon_150x150.png"
                          Square44x44Logo="icons\icon_44x44.png"
                          BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="icons\icon_310x150.png" />
        <uap:SplashScreen Image="icons\SplashScreen.png" />
      </uap:VisualElements>
      <uap:Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="markdown">
            <uap:DisplayName>Markdown-Dokument</uap:DisplayName>
            <uap:SupportedFileTypes><uap:FileType>.md</uap:FileType></uap:SupportedFileTypes>
            <uap:SupportedFileTypes><uap:FileType>.markdown</uap:FileType></uap:SupportedFileTypes>
            <uap:SupportedFileTypes><uap:FileType>.mdown</uap:FileType></uap:SupportedFileTypes>
            <uap:SupportedFileTypes><uap:FileType>.mkd</uap:FileType></uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </uap:Extensions>
    </Application>
  </Applications>
</Package>
